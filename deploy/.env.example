# Copy to .env and fill in. Used only on the first start: later the values
# stored in ./config are authoritative.

# Domain of the panel and WEB Proxy. Its A record must reach this server
# (directly or through a TCP forward of 80/443).
WPP_DOMAIN=proxy.example.com

# E-mail for Let's Encrypt expiry notices (optional, may stay empty).
WPP_ACME_EMAIL=

# Address in MTProto links (IP or name). Default: WPP_DOMAIN.
# Set the public IP when the domain is behind a CDN or another proxy.
WPP_PUBLIC_HOST=

# Public IPv4 from which this server reaches Telegram (MTProxy runs behind
# Docker NAT and must announce it). Empty: detected via api.ipify.org.
WPP_PUBLIC_IP=

# Panel administrator. An empty password is generated and printed once in
# `docker compose logs panel` (also saved to data/panel/initial-admin-password).
WPP_ADMIN_USER=admin
WPP_ADMIN_PASSWORD=

# Private panel address, /panel-<letters/digits>. Empty: generated.
WPP_PANEL_PATH=

# Image version.
WPP_TAG=2.3.6-2
