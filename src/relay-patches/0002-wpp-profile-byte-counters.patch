+package server
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strconv"
+	"testing"
+
+	"github.com/telegramdesktop/tproxy-server/internal/frame"
+)
+
+func TestMetricsCountBytesPerProfile(t *testing.T) {
+	backend := startEchoBackend(t)
+	app, _ := newConfiguredTestServer(t, backend, nil)
+	defer app.Shutdown()
+	hosted := httptest.NewServer(app.Handler())
+	defer hosted.Close()
+	admin := httptest.NewServer(app.AdminHandler())
+	defer admin.Close()
+
+	profile := app.manager.Profiles()[0]
+	bootstrap, err := app.manager.IssueBootstrap(&profile, "127.0.0.1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := perform(t, hosted.Client(), apiRequest(t, "POST", hosted.URL+"/api/v1/session", bootstrap, frame.Encode(frame.Hello, 0, []byte{1})))
+	readResponse(t, r)
+	token := r.Header.Get("X-Session-Token")
+	payload := []byte("profile-counter-payload")
+	body := append(frame.Encode(frame.Open, 5, nil), frame.Encode(frame.Data, 5, payload)...)
+	req := apiRequest(t, "POST", hosted.URL+"/api/v1/up", token, body)
+	req.Header.Set("X-Up-Seq", "1")
+	r = perform(t, hosted.Client(), req)
+	readResponse(t, r)
+	if r.StatusCode != 204 {
+		t.Fatal(r.StatusCode)
+	}
+	pollForData(t, hosted.Client(), hosted.URL, token, "0", map[uint32][]byte{5: payload})
+
+	get, _ := http.NewRequest("GET", admin.URL+"/metrics", nil)
+	r = perform(t, admin.Client(), get)
+	metrics := string(readResponse(t, r))
+	for _, direction := range []string{"up", "down"} {
+		pattern := regexp.MustCompile(fmt.Sprintf(`(?m)^tproxy_profile_bytes_%s_total\{profile="%s"\} (\d+)$`,
+			direction, regexp.QuoteMeta(profile.Name)))
+		match := pattern.FindStringSubmatch(metrics)
+		if match == nil {
+			t.Fatalf("no %s counter for %q in:\n%s", direction, profile.Name, metrics)
+		}
+		if value, _ := strconv.Atoi(match[1]); value < len(payload) {
+			t.Fatalf("%s counter %d < %d", direction, value, len(payload))
+		}
+	}
+}
