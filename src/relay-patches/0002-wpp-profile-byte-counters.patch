+// ProfileBytes returns the counters of every profile that carried traffic,
+// sorted by name.
+func (m *Manager) ProfileBytes() []ProfileBytes {
+	m.mu.Lock()
+	result := make([]ProfileBytes, 0, len(m.profileBytes))
+	for name, counter := range m.profileBytes {
+		result = append(result, ProfileBytes{Name: name, Up: counter.up.Load(), Down: counter.down.Load()})
+	}
+	m.mu.Unlock()
+	sort.Slice(result, func(i, j int) bool { return result[i].Name < result[j].Name })
+	return result
+}
