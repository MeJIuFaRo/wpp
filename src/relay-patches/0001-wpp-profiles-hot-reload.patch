+// Admin listener is loopback-only; reject browser-originated state changes too.
+func (s *Server) serveReloadProfiles(w http.ResponseWriter, r *http.Request) {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	ip := net.ParseIP(host)
+	if err != nil || ip == nil || !ip.IsLoopback() || r.Header.Get("Origin") != "" || r.Header.Get("X-WPP-Reload") != "1" {
+		http.Error(w, "forbidden", http.StatusForbidden)
+		return
+	}
+	if r.Method != http.MethodPost {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	if r.ContentLength != 0 || len(r.TransferEncoding) != 0 {
+		http.Error(w, "body not allowed", http.StatusBadRequest)
+		return
+	}
+	s.reloadMu.Lock()
+	defer s.reloadMu.Unlock()
+	profiles, err := s.config.ReloadProfiles()
+	if err != nil {
+		http.Error(w, "invalid profiles; running profiles unchanged", http.StatusBadRequest)
+		return
+	}
+	s.manager.ReloadProfiles(profiles)
+	w.Header().Set("Cache-Control", "no-store")
+	w.WriteHeader(http.StatusNoContent)
+}
