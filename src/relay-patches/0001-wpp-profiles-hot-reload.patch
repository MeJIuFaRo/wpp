+func (m *Manager) Profiles() []config.Profile {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return append([]config.Profile(nil), m.config.Profiles...)
+}
+
+// Replace immutable profile snapshots; preserve every unchanged session and stream.
+func (m *Manager) ReloadProfiles(profiles []config.Profile) {
+	profiles = append([]config.Profile(nil), profiles...)
+	for i := range profiles {
+		profiles[i].CarrierMode = profiles[i].CarrierMode.WithDefault()
+		profiles[i].Limits = profiles[i].Limits.WithDefaults(m.config.Limits)
+	}
+	same := func(p *config.Profile) bool {
+		for i := range profiles {
+			if profiles[i] == *p {
+				return true
+			}
+		}
+		return false
+	}
+	m.mu.Lock()
+	m.config.Profiles = profiles
+	for hash, entry := range m.bootstraps {
+		if !same(entry.profile) {
+			m.removeBootstrapLocked(hash, entry)
+		}
+	}
+	var closeSessions []*Session
+	for _, s := range m.sessions {
+		if !same(s.profile) {
+			closeSessions = append(closeSessions, s)
+		}
+	}
+	m.mu.Unlock()
+	// Close callbacks take m.mu, so never close while holding that lock.
+	for _, s := range closeSessions {
+		s.Close()
+	}
+}
+
 func (m *Manager) MatchCapability(value []byte) *config.Profile {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.matchCapabilityLocked(value)
+}
