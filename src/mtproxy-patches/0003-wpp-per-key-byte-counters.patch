diff -ruN a/net/net-connections.c b/net/net-connections.c
--- a/net/net-connections.c	2026-10-23 23:52:32.998500310 +0300
+++ b/net/net-connections.c	2026-10-23 23:52:31.000000000 +0300
@@ -82,6 +82,46 @@
 int active_special_connections, max_special_connections = MAX_CONNECTIONS;
 /* WPP: socket bytes of this connection type are counted as client traffic */
 conn_type_t *wpp_client_conn_type;
+long long wpp_secret_bytes[WPP_MAX_SECRETS][2];
+
+static void wpp_move_pending (struct connection_info *conn, int id) {
+  int direction;
+  for (direction = 0; direction < 2; direction++) {
+    long long moved = __sync_fetch_and_and (&conn->wpp_pending_bytes[direction], 0LL);
+    if (moved) {
+      __sync_fetch_and_add (&wpp_secret_bytes[id - 1][direction], moved);
+    }
+  }
+}
+
+/* The key is found by the connection's CPU thread while the socket is served
+   by a network thread. Bytes read before that wait in wpp_pending_bytes; both
+   sides move them after publishing/re-reading the key, so none is lost. */
+void wpp_attribute_secret (struct connection_info *conn, int secret_index) {
+  if (secret_index < 0 || secret_index >= WPP_MAX_SECRETS) {
+    return;
+  }
+  if (__sync_bool_compare_and_swap (&conn->wpp_secret_id, 0, secret_index + 1)) {
+    wpp_move_pending (conn, secret_index + 1);
+  }
+}
+
+static inline void wpp_count_secret_bytes (struct socket_connection_info *c, int direction, int bytes) {
+  if (!c->conn) {
+    return;
+  }
+  struct connection_info *conn = CONN_INFO (c->conn);
+  int id = __sync_fetch_and_add (&conn->wpp_secret_id, 0);
+  if (id > 0 && id <= WPP_MAX_SECRETS) {
+    __sync_fetch_and_add (&wpp_secret_bytes[id - 1][direction], (long long) bytes);
+    return;
+  }
+  __sync_fetch_and_add (&conn->wpp_pending_bytes[direction], (long long) bytes);
+  id = __sync_fetch_and_add (&conn->wpp_secret_id, 0);
+  if (id > 0 && id <= WPP_MAX_SECRETS) {
+    wpp_move_pending (conn, id);
+  }
+}
 
 int special_listen_sockets;
 
